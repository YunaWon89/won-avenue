NODE_ENV=development
PORT=5000
# On Vercel the Neon integration sets DATABASE_URL (POSTGRES_URL also works).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/food_delivery
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Fill an empty database with demo data on first start (useful for the first deploy)
SEED_ON_EMPTY=false
# Set to true for hosted Postgres that requires SSL without a verifiable cert
DATABASE_SSL=false

# Auto-translation of menus (optional). Get a free Gemini key at https://aistudio.google.com/apikey
# TRANSLATION_PROVIDER: auto (uses whichever key is set) | gemini | deepl | none
TRANSLATION_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
DEEPL_API_KEY=

# Demo mode: shows "Reset demo data" in the admin panel
DEMO_MODE=true

# Payments: mock (demo, no real money) | toss (Toss Payments, needs merchant keys)
PAYMENT_PROVIDER=mock
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# Automatic order progress (minutes): delivered/ready -> completed, unanswered -> cancelled
AUTO_COMPLETE_MINUTES=10
AUTO_CANCEL_MINUTES=15
# Days an owner has to fix a dish after the admin asks, before it is hidden
DISH_FIX_DAYS=3
